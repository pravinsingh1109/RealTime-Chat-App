# The server refuses to start in production without a strong, unique JWT_SECRET.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/realtime-chat
JWT_SECRET=replace-with-a-random-32-character-minimum-secret
JWT_EXPIRES_IN=7d
# Comma-separated browser origins allowed to call the API/socket server.
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
