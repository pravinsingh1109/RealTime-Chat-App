{
  "name": "realtime-chat-app",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready real-time chat application",
  "packageManager": "npm@10.8.2",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm --workspace=client run dev",
    "build": "npm --workspace=client run build && tsc --noEmit",
    "lint": "npm --workspace=client run lint",
    "test": "npm --workspace=client run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.13",
    "@vercel/node": "^5.1.10",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  }
}
