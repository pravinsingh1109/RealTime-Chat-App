# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/realtime-chat?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=replace-with-a-random-32-character-minimum-secret
JWT_EXPIRES_IN=7d

# Supabase Realtime Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client Environment Variables (for Vercel deployment)
VITE_API_URL=/api
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
