{
  "version": 2,
  "builds": [
    { "src": "api/**/*.ts", "use": "@vercel/node" },
    { "src": "client/api/**/*.ts", "use": "@vercel/node" },
    { "src": "client/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/health", "dest": "/api/health.ts" },
    { "src": "/api/auth/register", "dest": "/api/auth/register.ts" },
    { "src": "/api/auth/login", "dest": "/api/auth/login.ts" },
    { "src": "/api/auth/me", "dest": "/api/auth/me.ts" },
    { "src": "/api/users", "dest": "/api/users/index.ts" },
    { "src": "/api/users/(.*)", "dest": "/api/users/[userId].ts?userId=$1" },
    { "src": "/api/conversations", "dest": "/api/conversations/index.ts" },
    { "src": "/api/conversations/direct", "dest": "/api/conversations/direct.ts" },
    { "src": "/api/conversations/group", "dest": "/api/conversations/group.ts" },
    { "src": "/api/conversations/(.*)/messages", "dest": "/api/conversations/[conversationId]/messages.ts?conversationId=$1" },
    { "src": "/api/conversations/(.*)/read", "dest": "/api/conversations/[conversationId]/read.ts?conversationId=$1" },
    { "src": "/api/conversations/(.*)/group", "dest": "/api/conversations/[conversationId]/group.ts?conversationId=$1" },
    { "src": "/api/conversations/(.*)/members", "dest": "/api/conversations/[conversationId]/members.ts?conversationId=$1" },
    { "src": "/api/uploads/image", "dest": "/api/uploads/image.ts" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
